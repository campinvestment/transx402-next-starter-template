# Local-only integrator config. Copy to .env.local and fill values.
# Do NOT commit .env.local.
#
# Key family selects the network. Do not set a UI toggle.
#   ipk_sandbox_*  → sandbox config (CAMP, or local if FACILITATOR_URL is localhost)
#   ipk_live_*     → production config (Base). Real IDRX.

TRANSX402_API_KEY=ipk_sandbox_replace_me
MERCHANT_WALLET=0xYourMerchantWallet
PRICE_IDR=5000

# HMAC secret for pay-once page cookies (tx402_access_<resourceId>)
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string

# Optional cookie lifetime in seconds (default 7 days)
# ACCESS_TTL_SECONDS=604800

# Optional: point Route Handlers at a local Docker facilitator
# FACILITATOR_URL=http://localhost:3402

# Optional: agent private key for `pnpm smoke` (defaults to Anvil account #2)
# AGENT_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
